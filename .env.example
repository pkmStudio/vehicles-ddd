APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILES_DISK=s3
# FILES_ROOT=/absolute/path/to/shared/files
QUEUE_CONNECTION=vehicles
QUEUE_FAILED_DRIVER=null

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

RABBIT_TRANSPORT_CONNECTION=rabbitmq_inbox
RABBIT_TRANSPORT_QUEUE=vehicles.inbox
RABBIT_TRANSPORT_EXCHANGE=application.events
RABBIT_TRANSPORT_HMAC_ENABLED=false
RABBIT_TRANSPORT_HMAC_ALGO=sha256
RABBIT_TRANSPORT_HMAC_SECRET=

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Общий с другими сервисами бакет (AWS_BUCKET) — папка внутри него под обмен файлами
# между сервисами (диск 'exports', см. config/filesystems.php). Дефолт — 'exports'.
# AWS_EXPORTS_ROOT=exports

# Куда сохранять CSV-отчёты импорта с ошибками: local | exports | любой диск Storage.
IMPORT_FAILURES_REPORT_DISK=local

VITE_APP_NAME="${APP_NAME}"

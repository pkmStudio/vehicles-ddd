APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:aDy9X3EWWbyhtFipVZq79Xey6OGaX9NUR+h3Whu8Pe8=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Отдельная тестовая БД (см. plan.md §11, п.18) — тот же сервер/роль, что и в .env,
# просто другая database, чтобы тесты гоняли реальный Postgres, а не sqlite.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=dan_vehicles_test
DB_USERNAME=dan_vehicles
DB_PASSWORD=secret

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

CACHE_STORE=array
# CACHE_PREFIX=

MAIL_MAILER=array

BROADCAST_CONNECTION=null

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=2
REDIS_CACHE_DB=3

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
VEHICLES_QUEUE=vehicles
RABBITMQ_WORKER=horizon

RABBIT_TRANSPORT_CONNECTION=rabbitmq_inbox
RABBIT_TRANSPORT_QUEUE=vehicles.inbox
RABBIT_TRANSPORT_EXCHANGE=application.events
RABBIT_TRANSPORT_DLX_ENABLED=true

HORIZON_PREFIX=vehicles_horizon:

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

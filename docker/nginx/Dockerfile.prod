# Build app first: docker compose -f docker-compose.prod.yml build app
# Then build nginx (uses app image for static files)
FROM dan-center-app:latest AS app

FROM nginx:alpine

RUN apk add --no-cache openssl
RUN mkdir -p /etc/nginx/certs
RUN openssl req -newkey rsa:2048 -nodes -keyout /etc/nginx/certs/privkey.pem \
    -x509 -days 365 -out /etc/nginx/certs/fullchain.pem \
    -subj "/C=RU/ST=Moscow/L=Moscow/O=Dan-Center/CN=localhost"

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/public /var/www/public

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
